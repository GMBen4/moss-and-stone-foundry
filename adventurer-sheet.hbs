<form class="{{cssClass}} moss-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <input class="name" name="name" type="text" value="{{actor.name}}" placeholder="Adventurer Name" />
      <div class="identity-grid">
        <label>Species
          <select name="system.species" data-autofill="species">
            {{#each speciesOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <label>Adventurer Path
          <select name="system.path" data-autofill="path">
            {{#each pathOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
      </div>
    </div>
  </header>

  <section class="stat-strip">
    <div><b>Strikes</b><span class="counter"><button type="button" data-adjust="strikes.value" data-delta="-1">−</button><input type="number" name="system.strikes.value" value="{{system.strikes.value}}"/><span>/</span><input type="number" name="system.strikes.max" value="{{system.strikes.max}}"/><button type="button" data-adjust="strikes.value" data-delta="1">+</button></span></div>
    <div><b>Armor</b><input type="number" name="system.armorSave" value="{{system.armorSave}}"/><button type="button" data-roll="armor">Roll</button></div>
    <div><b>Miraculous</b><input type="number" name="system.miraculousSave" value="{{system.miraculousSave}}"/><button type="button" data-roll="miraculous">Roll</button></div>
    <div><b>Predator</b><input type="number" name="system.predatorDice" value="{{system.predatorDice}}"/><span>d6</span></div>
  </section>

  <section class="combat-quickbar">
    <h3>Combat</h3>
    <div class="combat-controls">
      <label class="attack-tn">Attack TN
        <input type="number" name="system.attackTarget" value="{{system.attackTarget}}" min="2" max="6"/>
      </label>
      <label class="attack-style">Attack Style
        <select name="system.attackStyle">
          <option value="melee" {{#if (eq system.attackStyle "melee")}}selected{{/if}}>Melee Weapon</option>
          <option value="largeMelee" {{#if (eq system.attackStyle "largeMelee")}}selected{{/if}}>Large / Two-Handed Melee</option>
          <option value="natural" {{#if (eq system.attackStyle "natural")}}selected{{/if}}>Natural / Bare Paws</option>
          <option value="polearm" {{#if (eq system.attackStyle "polearm")}}selected{{/if}}>Polearm</option>
          <option value="ranged" {{#if (eq system.attackStyle "ranged")}}selected{{/if}}>Ranged</option>
          <option value="mountedRanged" {{#if (eq system.attackStyle "mountedRanged")}}selected{{/if}}>Mounted Ranged</option>
          {{#if isFrogTosser}}
      <section class="choice-block path-resource-block">
        <h3>Frog Tosser — Frog Friend</h3>
        <div class="path-resource-line"><strong>Frog Status</strong><span class="path-resource-value">{{frogStatusLabel}}</span></div>
        <div class="two-col">
          <label>Traveler — Attack Boon
            <select name="system.frogTraveler" data-frog-config>
              <option value="" {{#unless system.frogTraveler}}selected{{/unless}}>— Choose —</option>
              <option value="melee" {{#if (eq system.frogTraveler "melee")}}selected{{/if}}>Melee Attacks</option>
              <option value="ranged" {{#if (eq system.frogTraveler "ranged")}}selected{{/if}}>Ranged Attacks</option>
            </select>
          </label>
          <label>The Way of the Frog
            <select name="system.frogWayChoice" data-frog-config>
              <option value="" {{#unless system.frogWayChoice}}selected{{/unless}}>— Choose —</option>
              <option value="inclination" {{#if (eq system.frogWayChoice "inclination")}}selected{{/if}}>Extra Inclination</option>
              <option value="boon" {{#if (eq system.frogWayChoice "boon")}}selected{{/if}}>Chosen Boon</option>
            </select>
          </label>
        </div>
        {{#if (eq system.frogWayChoice "boon")}}
        <label>Chosen Boon
          <select name="system.frogWayBoon" data-frog-config>
            <option value="" {{#unless system.frogWayBoon}}selected{{/unless}}>— Choose roll type —</option>
            <option value="melee" {{#if (eq system.frogWayBoon "melee")}}selected{{/if}}>Melee Attacks</option>
            <option value="ranged" {{#if (eq system.frogWayBoon "ranged")}}selected{{/if}}>Ranged Attacks</option>
            <option value="armor" {{#if (eq system.frogWayBoon "armor")}}selected{{/if}}>Armor Saves</option>
            <option value="miraculous" {{#if (eq system.frogWayBoon "miraculous")}}selected{{/if}}>Miraculous Saves</option>
            <option value="predator" {{#if (eq system.frogWayBoon "predator")}}selected{{/if}}>Predator Roll</option>
            <option value="checks" {{#if (eq system.frogWayBoon "checks")}}selected{{/if}}>General Checks</option>
            <option value="manual" {{#if (eq system.frogWayBoon "manual")}}selected{{/if}}>Other / Manual</option>
          </select>
        </label>
        {{/if}}
        <div class="path-action-grid">
          <button type="button" data-frog-tosser-action="pester" {{#if (eq system.frogStatus "knockedOut")}}disabled{{/if}}>Pester Target</button>
          <button type="button" data-frog-tosser-action="expose" {{#if (eq system.frogStatus "knockedOut")}}disabled{{/if}}>Expose Target</button>
          <button type="button" data-frog-tosser-action="recall" {{#if (eq system.frogStatus "knockedOut")}}disabled{{/if}}>Recall Frog</button>
          <button type="button" data-frog-tosser-action="sacrifice" {{#if (eq system.frogStatus "knockedOut")}}disabled{{/if}}>Sacrifice — Failed Armor Save</button>
        </div>
        <p class="rules-note"><strong>Pester / Expose:</strong> target exactly one enemy, then send the frog. Sending the frog somewhere new automatically clears its previous attachment. <strong>Pester</strong> gives that enemy a Bane when it attacks you; target the Frog Tosser before the enemy rolls so the system can apply it. <strong>Expose</strong> makes your attacks against the frog's target crit and confirm on 5+; target that enemy before attacking. <strong>Sacrifice:</strong> after you or an ally fails an Armor Save, target the attacker to deal 1 Strike and knock the frog out until End Scene.</p>
      </section>
      {{/if}}

      {{#if isSwarmMaster}}<option value="swarmStrike" {{#if (eq system.attackStyle "swarmStrike")}}selected{{/if}}>Swarm Strike (Ranged)</option>{{/if}}
        </select>
      </label>
      <div class="combat-buttons">
        <button type="button" data-attack="normal">Attack</button>
        <button type="button" data-attack="boon">Attack + Boon</button>
        <button type="button" data-attack="bane">Attack + Bane</button>
      </div>
    </div>
    <p class="rules-note">Attack Style lets the sheet apply only clear, context-free bonuses such as training, Mole claws, Barbarian large weapons, polearms, mounted ranged attacks, and Specialist crit ranges. Use the + Boon / + Bane buttons for situational modifiers.</p>
  </section>

  <section class="status-panel">
    <div class="predator-status status-dashboard">
      <span class="status-chip"><strong>Round:</strong> {{predatorStateLabel}}</span>
      <span class="status-chip"><strong>Karma:</strong> {{karmaStateLabel}}</span>
      <span class="status-chip"><strong>Predator Ability:</strong> {{predatorAbilityStateLabel}}</span>
    </div>
    {{#if automaticAbilityNotes}}<label>Automatic Ability Effects<textarea class="reference-text compact-reference" readonly>{{automaticAbilityNotes}}</textarea></label>{{/if}}
    {{#if itemSceneEffectsText}}<div class="active-sammich"><strong>Item Scene Effects: {{itemSceneEffectsText}}</strong><button type="button" data-clear-item-scene-effects>Clear at End of Scene</button></div>{{/if}}
    {{#if system.poisonActive}}<div class="danger-status"><strong>POISONED:</strong> 1 Bane on all actions except Armor and Miraculous Saves. Attack rolls apply this automatically.</div>{{/if}}
    {{#if system.poisonTerminal}}<div class="danger-status"><strong>TERMINAL POISON:</strong> cannot be cured; death occurs on the next sleep.</div>{{/if}}
    {{#if supplyEffectsText}}<label>Travel Penalties<textarea class="reference-text compact-reference" readonly>{{supplyEffectsText}}</textarea></label>{{/if}}
    {{#if brokenSpiritsActive}}<label>Broken Spirits — Lost Inclination<select name="system.suppressedInclination">{{#each suppressedInclinationOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
    {{#if damagedEquipmentCritVulnerable}}<div class="danger-status"><strong>DAMAGED EQUIPMENT:</strong> Armor was already 6+, so enemies crit you on 5+ until you rest at a Safe Zone.</div>{{/if}}
  </section>

  <section class="resource-row">
    <label>Karma <span class="counter"><button type="button" data-adjust="karma" data-delta="-1">−</button><input type="number" name="system.karma" value="{{system.karma}}"/><button type="button" data-adjust="karma" data-delta="1">+</button></span></label>
    <label>Hero Dice <span class="counter"><button type="button" data-adjust="heroDice" data-delta="-1">−</button><input type="number" name="system.heroDice" value="{{system.heroDice}}"/><button type="button" data-adjust="heroDice" data-delta="1">+</button></span></label>
    <label>Poison Marks <span class="counter"><button type="button" data-adjust="poisonMarks" data-delta="-1">−</button><input type="number" name="system.poisonMarks" value="{{system.poisonMarks}}"/><button type="button" data-adjust="poisonMarks" data-delta="1">+</button></span><button type="button" data-roll="poison">Poison Save / Daily Save</button></label>
  </section>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="main">Character</a>
    <a class="item" data-tab="abilities">Species & Path</a>
    <a class="item" data-tab="gear">Gear</a>
    <a class="item" data-tab="notes">Notes</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="main">
      <div class="roll-bar"><button type="button" data-roll="d6">1d6 Check</button><button type="button" data-roll="boon">Boon</button><button type="button" data-roll="bane">Bane</button></div>

      <section class="choice-block">
        <h3>Inclinations</h3>
        {{#if inclinationsDisabled}}
          <p class="rules-note">The Corrupted Adventurer Path cannot choose Inclinations.</p>
        {{else}}
          <div class="two-col">
            <label>Inclination 1
              <select name="system.inclination1" data-reference-select="inclination1">
                {{#each inclination1Options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
              <textarea class="reference-text compact-reference" readonly>{{inclination1Rules}}</textarea>
            </label>
            <label>Inclination 2
              <select name="system.inclination2" data-reference-select="inclination2">
                {{#each inclination2Options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
              <textarea class="reference-text compact-reference" readonly>{{inclination2Rules}}</textarea>
            </label>
          </div>
          {{#if frogWayExtraInclination}}
            <label>Inclination 3 — The Way of the Frog
              <select name="system.inclination3" data-reference-select="inclination3">
                {{#each inclination3Options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
              <textarea class="reference-text compact-reference" readonly>{{inclination3Rules}}</textarea>
            </label>
          {{/if}}
        {{/if}}
      </section>

      {{#if hasInclinationTools}}
      <section class="choice-block inclination-tools">
        <h3>Inclination Tools</h3>
        {{#if hasMossPack}}
          <div class="path-resource-line"><strong>Moss Pack</strong><button type="button" data-inclination-action="moss-pack-start">Set Session Start — 6 Karma</button></div>
        {{/if}}
        {{#if hasMossTouched}}
          <div class="path-resource-line"><strong>Moss Touched</strong><button type="button" data-inclination-action="moss-touched-start">Set Session Start — 2 Hero Dice</button></div>
        {{/if}}
        {{#if hasChef}}
          <div class="path-resource-line"><strong>Chef</strong><span>Starting food and Safe Zone cooking</span></div>
          <div class="path-action-grid">
            <button type="button" data-inclination-action="chef-start" {{#if chefStartingGranted}}disabled{{/if}}>Grant 2 Starting Sammiches</button>
            <button type="button" data-inclination-action="chef-safezone">Make Safe Zone Sammiches</button>
          </div>
          <p class="rules-note">Chef starts with 2 Sammiches of your choice. At a Safe Zone, this creates a number of random Sammiches equal to the Safe Zone Tier.</p>
        {{/if}}
        {{#if hasScarred}}
          <div class="two-col">
            <label>Scarred — Boon Type 1
              <select name="system.scarredBoon1" data-scarred-config>{{#each scarredBoon1Options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </label>
            <label>Scarred — Boon Type 2
              <select name="system.scarredBoon2" data-scarred-config>{{#each scarredBoon2Options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </label>
          </div>
          <p class="rules-note">Scarred grants +1 Boon to two action types and those Boons stack with other sources. Karma remains permanently unavailable. Choose Other / Manual for a type the sheet cannot classify automatically.</p>
        {{/if}}
      </section>
      {{/if}}

      <section class="choice-block">
        <h3>Predator Ability</h3>
        <label>
          <select name="system.predatorAbility" data-reference-select="predatorAbility">
            {{#each predatorAbilityOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <textarea class="reference-text compact-reference" readonly>{{predatorAbilityRules}}</textarea>
        </label>
        <p class="rules-note">Predator Abilities normally function only when your party wins the Predator Roll, unless the ability says otherwise.</p>
      </section>

      <section class="choice-block flaw-block">
        <h3>Flaw</h3>
        <label>Flaw Name<input type="text" name="system.flawName" value="{{system.flawName}}" placeholder="e.g. Bum Leg, Sensitive Nose, Known Troublemaker"/></label>
        <label>Description<textarea name="system.flaws" placeholder="Describe when this Flaw could complicate your actions...">{{system.flaws}}</textarea></label>
        <div class="flaw-controls">
          <button type="button" data-flaw-action="invoke" {{#if system.flawUsed}}disabled{{/if}}>Invoke Flaw</button>
          <span class="flaw-status">{{#if system.flawUsed}}Used this scene{{else}}Ready{{/if}}</span>
          <button type="button" data-flaw-action="reset">Reset for New Scene</button>
        </div>
        <p class="rules-note">Invoke a Flaw when it makes narrative sense and the action would normally have at least 1d6 with no Banes. The action becomes 2d6 keep lowest, overriding Boons. Gain 2 Karma whether you pass or fail, plus 1 Hero Die for each die showing 6. Each Flaw may be used once per scene.</p>
      </section>

      <label>Aspect<textarea name="system.aspects">{{system.aspects}}</textarea></label>
    </div>

    <div class="tab" data-group="primary" data-tab="abilities">
      <label>Species Abilities<textarea class="reference-text" readonly>{{speciesAbilities}}</textarea></label>
      <label>Adventurer Path Abilities<textarea class="reference-text path-reference" readonly>{{pathAbilities}}</textarea></label>

      {{#if isShieldBearer}}
      <section class="choice-block path-resource-block warrior-panel">
        <h3>Shield Bearer — Shield & Defense</h3>
        <div class="path-resource-line"><strong>Shield</strong><span class="path-resource-value">{{#if shieldIntact}}Intact{{else}}Broken{{/if}}</span></div>
        <div class="path-action-grid">
          <button type="button" data-warrior-action="shield-expertise" {{#unless shieldExpertiseReady}}disabled{{/unless}} {{#unless shieldIntact}}disabled{{/unless}}>Shield Expertise — Absorb 1 Strike</button>
          <button type="button" data-warrior-action="intercept">Intercept — Armor Save for Ally</button>
          <button type="button" data-warrior-action="defensive-hero">Staying Alive — Defensive Hero Die</button>
          <button type="button" data-warrior-action="not-today-break" {{#unless shieldNotTodayReady}}disabled{{/unless}} {{#unless shieldIntact}}disabled{{/unless}}>Not Today! — Break Shield</button>
          <button type="button" data-warrior-action="not-today-karma" {{#unless shieldNotTodayReady}}disabled{{/unless}} {{#unless shieldIntact}}disabled{{/unless}}>Not Today! — Spend 5 Karma</button>
          <button type="button" data-warrior-action="new-shield">New Shield / Restore Shield</button>
        </div>
        <p class="rules-note"><strong>Unmovable</strong> remains automatic: Shield Bearers can only make melee attacks, ignore all Banes on those attacks, cannot crit, and gain +1 Karma when the attack die shows 6.</p>
        <p class="rules-note"><strong>Extra Defense</strong> is automatic while the shield is intact: Armor Saves gain a Boon, and a rolled 6 deals 1 Strike to the attacker. Target exactly one enemy before the save to apply that Strike automatically. <strong>Shield Expertise</strong> is once per scene. <strong>Intercept</strong> is unlimited; target the adjacent ally before rolling. <strong>Not Today!</strong> is once per scene and protects from all attack damage for a round; if the shield breaks, reflection is tracked manually because more than one attacker may be involved.</p>
      </section>
      {{/if}}

      {{#if isBarbarian}}
      <section class="choice-block path-resource-block warrior-panel">
        <h3>Barbarian — Fury</h3>
        {{#if barbarianBloodlustPrimed}}<div class="status-note"><strong>Bloodlust primed:</strong> the next Attack is the free follow-up. A hit is a guaranteed crit.</div>{{/if}}
        <div class="path-action-grid">
          <button type="button" data-warrior-action="too-angry">Too Angry to Die — Last Strike</button>
          <button type="button" data-warrior-action="bloodlust" {{#if barbarianBloodlustPrimed}}disabled{{/if}}>Bloodlust — Prime Free Attack</button>
        </div>
        <p class="rules-note"><strong>Large Weapon</strong> and <strong>Everything is a Weapon</strong> are automatic with Large / Two-Handed Melee selected: the attack gets its Boon and crits on 5–6. Use Too Angry to Die when an incoming hit would remove your final Strike. Use Bloodlust only after a killing blow when an adjacent enemy you have not attacked this turn is available.</p>
      </section>
      {{/if}}

      {{#if isHollowTongueHunter}}
      <section class="choice-block path-resource-block warrior-panel">
        <h3>Hollow Tongue Hunter — Polearm & Jump</h3>
        {{#if hunterAirborne}}<div class="status-note"><strong>Airborne:</strong> out of reach until next turn. Crash Down is ready.</div>{{/if}}
        <div class="path-action-grid">
          <button type="button" data-warrior-action="polearm-approach">Polearm — Intercept Approach</button>
          <button type="button" data-warrior-action="polearm-retreat">Polearm — Stop Retreat</button>
          <button type="button" data-warrior-action="nimble">Nimble — Jumping Miraculous Save</button>
          <button type="button" data-warrior-action="jump" {{#if hunterAirborne}}disabled{{/if}}>Jump — Go Airborne</button>
          <button type="button" data-warrior-action="crash" {{#unless hunterAirborne}}disabled{{/unless}}>Jump — Crash Down</button>
        </div>
        <p class="rules-note"><strong>Polearm Expert</strong> automatically grants its attack Boon when Polearm is selected. The reaction buttons remind the table when its free attacks apply; make the actual free attack with the normal Attack button so every current modifier is preserved. <strong>Nimble</strong> rolls the jumping Miraculous Save with its extra Boon. <strong>Jump</strong> tracks the airborne turn and resolves the automatic crit/confirm chain on Crash Down.</p>
        <p class="rules-note"><strong>Legendary</strong> is automatic while a Hollow Tongue is in the encounter: +1 Boon to melee attacks, Armor Saves, and Miraculous Saves, plus +2 Boons to the party Predator Roll for each Hollow Tongue Hunter present.</p>
      </section>
      {{/if}}

      {{#if isScholar}}
      <section class="choice-block path-resource-block">
        <h3>Scholar — Study & Collector</h3>
        <div class="path-action-grid">
          <button type="button" data-scholar-action="tactician">{{#if scholarTacticianPrimed}}Cancel Tactician{{else}}Prime Tactician Predator Roll{{/if}}</button>
          <button type="button" data-scholar-action="collector-start" {{#if scholarCollectorInitialized}}disabled{{/if}}>Collector — Start with 3 Random Stones</button>
          <button type="button" data-scholar-action="collector-safezone">Collector — Gain Safe Zone Stone</button>
        </div>
        <p class="rules-note"><strong>Tactician:</strong> the next Predator Round uses this Scholar's own Predator Rating and can spend Karma on that roll. <strong>Collector:</strong> start with 3 random Whisper Stones and gain 1 random Whisper Stone when visiting a Tier 2 or Tier 3 Safe Zone. <strong>Whisper Stone Enthusiast:</strong> Scholars identify Whisper Stones immediately. <strong>I Read the Manual:</strong> already resolves automatically when using a Whisper Stone.</p>
      </section>
      {{/if}}

      {{#if isPriest}}
      <section class="choice-block path-resource-block">
        <h3>Priest — Faith & Whisper Stones</h3>
        <div class="path-resource-line"><strong>Faith Stone 1</strong><span class="path-resource-value">{{#if priestStone1Charged}}Charged{{else}}Spent — recharges tonight{{/if}}</span></div>
        <div class="path-resource-line"><strong>Faith Stone 2</strong><span class="path-resource-value">{{#if priestStone2Charged}}Charged{{else}}Spent — recharges tonight{{/if}}</span></div>
        <div class="path-action-grid">
          <button type="button" data-priest-action="stone-1" {{#unless priestStone1Charged}}disabled{{/unless}}>Attempt / Cast Faith Stone 1</button>
          <button type="button" data-priest-action="stone-2" {{#unless priestStone2Charged}}disabled{{/unless}}>Attempt / Cast Faith Stone 2</button>
        </div>
        <p class="rules-note"><strong>Essential Tools of the Faith:</strong> each special stone reveals a random effect only when you attempt to cast it. You may reroll that effect once and keep whichever result you prefer. Both stones recharge after every night's rest. An unidentified normal Whisper Stone also gets this reroll option when a Priest uses it.</p>
        <hr>
        <h4>I Believe in Miracles</h4>
        <label>Prayer / Requested Miracle<textarea name="system.priestMiracleRequest" placeholder="Describe what you ask the Green Voice to do...">{{system.priestMiracleRequest}}</textarea></label>
        <div class="two-col">
          <label>Urgency Dice (1–3d6)<input type="number" name="system.priestMiracleUrgency" value="{{system.priestMiracleUrgency}}" min="1" max="3"/></label>
          <label>RR Aloofness Dice<input type="number" name="system.priestMiracleAloofness" value="{{system.priestMiracleAloofness}}" min="1" max="12"/></label>
        </div>
        <div class="path-action-grid">
          <button type="button" data-priest-action="miracle" {{#unless priestMiracleReady}}disabled{{/unless}}>Petition for Miracle {{#unless priestMiracleReady}}— Used This Scene{{/unless}}</button>
          <button type="button" data-priest-action="blessing-reroll" {{#unless priestBlessingReady}}disabled{{/unless}}>Blessing Reroll — RR Approved {{#unless priestBlessingReady}}— Used Today{{/unless}}</button>
        </div>
        <p class="rules-note">Core EZD6 Miracle rules: the RR rolls Aloofness, then the Priest rolls 1–3 prayer dice. At least one prayer die must equal or beat the highest Aloofness die, but any prayer die showing 1 automatically fails the petition. Karma cannot be used. A Hero Die may reroll one prayer die. A sufficient offering may grant one full prayer reroll per day. A miracle cannot harm or damage another being, and only one miracle may be requested per scene/situation. The RR has final approval.</p>
        <p class="rules-note"><strong>Fear No Evil:</strong> when this Priest is the party's Predator roller against a Hollow Tongue, +2 Boons are automatic. <strong>Righteous Fury:</strong> Karma remains available to the Priest against Hollow Tongues regardless of the Predator outcome.</p>
      </section>
      {{/if}}

      {{#if isCorrupted}}
      <section class="choice-block path-resource-block corrupted-panel">
        <h3>Corrupted — One With the Stone</h3>
        {{#if corruptedTransformed}}
          <div class="status-note"><strong>A Deal Kept:</strong> This character has reached 0 Strikes and become a Hollow Tongue. They are no longer under player control.</div>
          <button type="button" data-corrupted-action="clear-transformation">GM: Return Control / Clear Transformation</button>
        {{/if}}
        <label>Corrupted Whisper Stone Power
          <select name="system.corruptedPower">
            {{#each corruptedPowerOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <textarea class="reference-text compact-reference" readonly>{{corruptedPowerDescription}}</textarea>
        <label>Casting Intent<textarea name="system.corruptedCastingIntent" placeholder="Describe what you want the corrupted power to do...">{{system.corruptedCastingIntent}}</textarea></label>
        <label>RR Casting Dice<input type="number" name="system.corruptedCastingDice" value="{{system.corruptedCastingDice}}" min="1" max="12"/></label>
        <div class="path-action-grid">
          <button type="button" data-corrupted-action="cast" {{#if corruptedPending}}disabled{{/if}}>Use Corrupted Power</button>
          <button type="button" data-corrupted-action="stone-armor" {{#if corruptedPending}}disabled{{/if}}>Stone Armor Save</button>
          <button type="button" data-corrupted-action="stone-miraculous" {{#if corruptedPending}}disabled{{/if}}>Stone Miraculous Save</button>
          <button type="button" data-corrupted-action="daily-recovery">Daily Recovery — 2d6 Keep Lowest</button>
        </div>
        {{#if corruptedPending}}
          <div class="status-note"><strong>Pending Corrupted Casting:</strong> {{corruptedPendingOnes}} result(s) of 1 remain. Resolve only after deciding whether to spend Hero Dice.</div>
          <div class="path-action-grid">
            <button type="button" data-corrupted-action="reroll-one" {{#unless corruptedCanReroll}}disabled{{/unless}}>Spend 1 Hero Die — Reroll One 1</button>
            <button type="button" data-corrupted-action="resolve">Resolve Casting</button>
          </div>
        {{/if}}
        <div class="path-resource-line"><strong>Additional Corruption Flaws</strong><span class="path-resource-value">{{system.corruptedFlawCount}}</span></div>
        <label>Describe Acquired Flaws<textarea name="system.corruptedAcquiredFlaws" placeholder="Record the new physical or narrative Flaws caused by corruption...">{{system.corruptedAcquiredFlaws}}</textarea></label>
        <p class="rules-note"><strong>A Deal Made:</strong> choose one Corrupted Whisper Stone power. Corrupted characters cannot choose Inclinations.</p>
        <p class="rules-note"><strong>Casting:</strong> the intended effect always works. The RR chooses the number of d6 based on complexity and power. Each remaining 1 causes 1 Strike of normal damage, adds a new Flaw, and gives the RR one complication affecting allies, enemies, or the environment. Karma cannot be used. If the effect needs to persist, the RR may require it to be Anchored using the core EZD6 casting rules; Anchoring is handled narratively rather than automated here.</p>
        <p class="rules-note"><strong>Just a Little More:</strong> unlike ordinary Corrupted Whisper Stone users, this Path may spend Hero Dice to reroll individual 1s, including multiple Hero Dice.</p>
        <p class="rules-note"><strong>Dancing with the Devil:</strong> Stone Armor Save and Stone Miraculous Save automatically accomplish the save, but resolve the casting risks normally.</p>
        <p class="rules-note"><strong>Not the Same Critter:</strong> consumables, healing, and temporary Strikes do not affect you. At the beginning of each day, heal 2d6 keep lowest instead. Safe Zone and nightly rest automation use this recovery automatically.</p>
      </section>
      {{/if}}

      {{#if isMossMedic}}
      <section class="choice-block path-resource-block">
        <h3>Moss Medic — Bag of Moss</h3>
        <div class="path-resource-line">
          <strong>Moss Uses</strong>
          <span class="path-resource-value">{{mossBagUses}} / 6</span>
        </div>
        <div class="path-action-grid">
          <button type="button" data-moss-medic-action="heal">Heal with Moss</button>
          <button type="button" data-moss-medic-action="absorption">Treat Poison — Absorption</button>
          <button type="button" data-moss-medic-action="regrowth" {{#unless mossRegrowthReady}}disabled{{/unless}}>Regrowth {{#unless mossRegrowthReady}}— Used{{/unless}}</button>
          <button type="button" data-moss-medic-action="prayer" {{#unless mossPrayerReady}}disabled{{/unless}}>Prayer {{#unless mossPrayerReady}}— Used{{/unless}}</button>
          <button type="button" data-moss-medic-action="edible">Post Edible Healing</button>
        </div>
        {{#if poisonCurePending}}<div class="status-note"><strong>Absorption:</strong> Poison cure is pending after the next night's sleep.</div>{{/if}}
        <p class="rules-note">For Heal with Moss or Absorption, target one Adventurer token. With no target selected, the Moss Medic targets themself. Safe Zones refill the bag to 6 uses. A night's sleep resets Regrowth and Prayer for the new day.</p>
      </section>
      {{/if}}

      {{#if isCombatMedic}}
      <section class="choice-block path-resource-block">
        <h3>Combat Medic — Med Kit</h3>
        <div class="path-resource-line">
          <strong>Med Kit Uses</strong>
          <span class="path-resource-value">{{medKitUses}} / 6</span>
        </div>
        <div class="path-action-grid">
          <button type="button" data-combat-medic-action="heal">Heal with Med Kit</button>
          <button type="button" data-combat-medic-action="rapid">Rapid Bandage</button>
          <button type="button" data-combat-medic-action="antidote">Antidote</button>
          <button type="button" data-combat-medic-action="surprise">Confirmed Crit → Surprise Supplies</button>
        </div>
        <p class="rules-note">Heal with Med Kit targets one Adventurer token, or yourself with no target. Rapid Bandage works once per combat round and uses your attack action. Antidote only works outside combat. Tier 2 and Tier 3 Safe Zones refill the Med Kit to 6 uses. For Surprise Supplies, target the enemy whose confirmed crit you are trading.</p>
      </section>
      {{/if}}

      {{#if isHarvester}}
      <section class="choice-block path-resource-block">
        <h3>Harvester — Poison Kit & Harvests</h3>
        <div class="path-resource-line"><strong>Poison Kit Uses</strong><span class="path-resource-value">{{poisonKitUses}} / 6</span></div>
        <div class="path-resource-line"><strong>Weapon Coating</strong><span class="path-resource-value">{{harvesterCoatingLabel}}</span></div>
        <div class="path-action-grid">
          <button type="button" data-harvester-action="coat-damage">Coat Weapon — +1 Strike</button>
          <button type="button" data-harvester-action="coat-bane">Coat Weapon — Bane</button>
          <button type="button" data-harvester-action="clear-coating">Clear Coating</button>
          <button type="button" data-harvester-action="poison-removal">Poison Removal</button>
        </div>
        <hr>
        <div class="path-resource-line"><strong>Harvests Available</strong><span class="path-resource-value">{{harvestUses}}</span></div>
        <div class="path-resource-line"><strong>Harvested Tool</strong><span class="path-resource-value">{{harvestedToolLabel}}</span></div>
        <div class="path-action-grid">
          <button type="button" data-harvester-action="take-harvest">Harvest Remains +1</button>
          <button type="button" data-harvester-action="harvest-offense">Tools of the Trade — Offense</button>
          <button type="button" data-harvester-action="harvest-defense">Tools of the Trade — Defense</button>
          <button type="button" data-harvester-action="clear-tool">Clear Broken Tool</button>
          <button type="button" data-harvester-action="blood">Blood for Blood</button>
          <button type="button" data-harvester-action="poison-refill">Poison-Capable Harvest → Refill</button>
        </div>
        <p class="rules-note">Weapon poison is consumed on a melee hit; a ranged attack consumes it even on a miss. For Bane poison, target exactly one enemy so the sheet can mark it automatically. Poison Removal is for use outside combat after the target has already failed their normal Poison Save. Tier 2 and Tier 3 Safe Zones refill the Poison Kit.</p>
        <p class="rules-note"><strong>Questionable Ethics:</strong> Predator Rating is +2 against other Critters. This remains an RR/player-facing modifier because the system does not classify every enemy as a Critter.</p>
      </section>
      {{/if}}

      {{#if isReptileRider}}
      <section class="choice-block path-resource-block">
        <h3>Reptile Rider — Trusted Companion</h3>
        <div class="path-resource-line"><strong>Riding Status</strong><span class="path-resource-value">{{reptileMountedLabel}}</span></div>
        <div class="path-resource-line">
          <strong>Reptile Strikes</strong>
          <span class="counter"><button type="button" data-adjust="reptileStrikes.value" data-delta="-1">−</button><input type="number" name="system.reptileStrikes.value" value="{{system.reptileStrikes.value}}"/><span>/</span><input type="number" name="system.reptileStrikes.max" value="{{system.reptileStrikes.max}}"/><button type="button" data-adjust="reptileStrikes.value" data-delta="1">+</button></span>
        </div>
        <div class="path-action-grid">
          <button type="button" data-reptile-rider-action="mount" {{#if system.reptileMounted}}disabled{{/if}}>Mount</button>
          <button type="button" data-reptile-rider-action="dismount" {{#unless system.reptileMounted}}disabled{{/unless}}>Dismount</button>
          <button type="button" data-reptile-rider-action="bite">Reptile Bite — Attack Action</button>
          <button type="button" data-reptile-rider-action="reptile-armor" {{#if system.reptileMounted}}disabled{{/if}}>Reptile Armor Save</button>
          <button type="button" data-reptile-rider-action="reptile-miraculous" {{#if system.reptileMounted}}disabled{{/if}}>Reptile Miraculous Save</button>
        </div>
        <label>Reptile Special Ability<textarea name="system.reptileSpecialAbility" placeholder="e.g. Gecko feet, spit attack, tail grapple, camouflage...">{{system.reptileSpecialAbility}}</textarea></label>
        <button type="button" data-reptile-rider-action="post-special">Post Special Ability to Chat</button>
        <p class="rules-note"><strong>Ranger Training:</strong> ranged attacks automatically gain a Boon. <strong>Mounted Calvary:</strong> while mounted, ranged attacks crit and confirm on 5+. <strong>Scary Scales:</strong> a mounted Rider adds a Boon to the party Predator roll. <strong>Evasive Maneuvers:</strong> while mounted, an Armor Save result of 1 is automatically rerolled once per combat round. <strong>Saddle Bags:</strong> Safe Zones provide +2 Supplies per Reptile Rider. <strong>Bonded:</strong> while dismounted, the reptile uses your Armor and Miraculous Save ratings; you may both move, but only one of you may take the attack action.</p>
      </section>
      {{/if}}

      {{#if isSwarmMaster}}
      <section class="choice-block path-resource-block">
        <h3>Swarm Master — Swarm Techniques</h3>
        <div class="path-action-grid">
          <button type="button" data-swarm-master-action="fist" {{#unless swarmFistReady}}disabled{{/unless}}>Fist of Fury {{#unless swarmFistReady}}— Used{{/unless}}</button>
          <button type="button" data-swarm-master-action="tandem-armor">Armor Save — Area/Cleave</button>
        </div>
        <p class="rules-note"><strong>Bug-Fu:</strong> automatically resolves alongside every Natural / Bare Paws attack; the extra 1d6 only hits on a natural 6 and may confirm crits. <strong>Fist of Fury:</strong> once per combat, roll 3d6 as three independent attacks; Karma can be applied to individual dice manually. <strong>Swarm Strike:</strong> choose Swarm Strike (Ranged) from Attack Style and use the normal Attack controls; it cannot crit and does not require ammunition. <strong>Tandem Troubles:</strong> use the Area/Cleave Armor Save button when the incoming attack affects an area or cleaves; it automatically applies 1 Bane.</p>
      </section>
      {{/if}}
      <p class="rules-note">Changing Species or Adventurer Path automatically recalculates Strikes, Armor Save, Miraculous Save, and Predator Rating. You may still edit those values manually afterward for temporary or campaign changes.</p>
    </div>

    <div class="tab" data-group="primary" data-tab="gear">
      <label>Equipment<textarea name="system.equipment">{{system.equipment}}</textarea></label>

      <section class="inventory-block">
        <div class="inventory-heading"><h3>Whisper Stones</h3><span class="rules-note">Drag Whisper Stone Items onto this sheet.</span></div>
        {{#each whisperStoneItems}}
          <article class="inventory-item {{#if drained}}is-drained{{/if}}">
            <div class="inventory-main">
              <strong>{{name}}</strong>
              {{#if drained}}<span class="item-state">DRAINED</span>{{else}}{{#unless identified}}<span class="item-state">UNIDENTIFIED</span>{{/unless}}{{/if}}
              {{#if ../studentStoneKnowledge}}<p>{{description}}</p>{{else}}{{#if identified}}<p>{{description}}</p>{{else}}<p class="rules-note">Its power is unknown. A Student can identify it, or it can be identified at a Tier 2 or 3 Safe Zone.</p>{{/if}}{{/if}}
            </div>
            <div class="inventory-actions">
              <button type="button" data-item-use="{{id}}" {{#if drained}}disabled{{/if}}>Use</button>
              <button type="button" data-item-edit="{{id}}">Edit</button>
              <button type="button" data-item-delete="{{id}}">Delete</button>
            </div>
          </article>
        {{else}}<p class="empty-inventory">No Whisper Stones.</p>{{/each}}
      </section>

      <section class="inventory-block">
        <div class="inventory-heading"><h3>Sammiches</h3><span class="rules-note">Eating a second Sammich replaces the first effect for the day.</span></div>
        {{#if system.activeSammichName}}
          <div class="active-sammich"><strong>Current: {{system.activeSammichName}}</strong><p>{{system.activeSammichEffect}}</p><div class="inventory-actions">{{#if hasSammichGyroAction}}<button type="button" data-sammich-action="gyro">Convert 3 Karma → 1 Hero Die</button>{{/if}}{{#if hasSammichHabeneroAction}}<button type="button" data-sammich-action="habenero">Extra Attack Risk Roll</button>{{/if}}<button type="button" data-clear-sammich>Clear at New Day</button></div></div>
        {{else}}<div class="active-sammich muted"><strong>No active Sammich effect.</strong></div>{{/if}}
        {{#each sammichItems}}
          <article class="inventory-item">
            <div class="inventory-main"><strong>{{name}}</strong><p>{{description}}</p></div>
            <div class="inventory-actions">
              <button type="button" data-item-use="{{id}}">Eat</button>
              <button type="button" data-item-edit="{{id}}">Edit</button>
              <button type="button" data-item-delete="{{id}}">Delete</button>
            </div>
          </article>
        {{else}}<p class="empty-inventory">No Sammiches.</p>{{/each}}
      </section>

      <section class="inventory-block">
        <div class="inventory-heading"><h3>Tinker Tools</h3><span class="rules-note">Carried: {{tinkerToolItems.length}} / {{tinkerToolLimit}}</span></div>
        {{#if tinkerToolOverLimit}}<div class="danger-status"><strong>Too many Tinker Tools:</strong> normally you can carry 1; the Engineer Inclination allows 2.</div>{{/if}}
        {{#each tinkerToolItems}}
          <article class="inventory-item">
            <div class="inventory-main"><strong>{{name}}</strong><span class="item-state">Tier {{tier}}</span><p>{{description}}</p></div>
            <div class="inventory-actions">
              <button type="button" data-item-use="{{id}}">Use / Post</button>
              <button type="button" data-item-edit="{{id}}">Edit</button>
              <button type="button" data-item-delete="{{id}}">Delete</button>
            </div>
          </article>
        {{else}}<p class="empty-inventory">No Tinker Tools.</p>{{/each}}
      </section>

      {{#if system.tinkerTool}}<details class="legacy-items"><summary>Legacy Tinker Tool Notes</summary><textarea name="system.tinkerTool">{{system.tinkerTool}}</textarea></details>{{/if}}
      {{#if system.whisperStones}}<details class="legacy-items"><summary>Legacy Whisper Stone Notes</summary><textarea name="system.whisperStones">{{system.whisperStones}}</textarea></details>{{/if}}
    </div>

    <div class="tab" data-group="primary" data-tab="notes"><label>Notes<textarea class="big-notes" name="system.notes">{{system.notes}}</textarea></label></div>
  </section>
</form>
