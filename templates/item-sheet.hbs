<form class="{{cssClass}} moss-item-sheet" autocomplete="off">
  <header class="sheet-header item-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <input class="name" name="name" type="text" value="{{item.name}}" placeholder="{{itemTypeLabel}} Name"/>
      <div class="item-type-title">{{itemTypeLabel}}</div>
    </div>
  </header>

  <section class="item-content">
    {{#if isWhisperStone}}
      <div class="two-col item-flags">
        <label><input type="checkbox" name="system.identified" {{#if system.identified}}checked{{/if}}/> Identified</label>
        <label><input type="checkbox" name="system.drained" {{#if system.drained}}checked{{/if}}/> Drained</label>
      </div>
    {{/if}}

    {{#if isTinkerTool}}
      <label>Safe Zone Tier<input type="number" name="system.tier" value="{{system.tier}}" min="1" max="3"/></label>
    {{/if}}

    <label>Rules / Effect<textarea class="item-description" name="system.description">{{system.description}}</textarea></label>
    <button type="button" data-item-post>Post to Chat</button>
  </section>
</form>
