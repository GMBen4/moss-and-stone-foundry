<form class="{{cssClass}} moss-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields"><input class="name" name="name" type="text" value="{{actor.name}}" placeholder="Enemy Name" /></div>
  </header>
  <section class="stat-strip">
    <div><b>Strikes</b><span class="counter"><button type="button" data-adjust="strikes.value" data-delta="-1">−</button><input type="number" name="system.strikes.value" value="{{system.strikes.value}}"/><span>/</span><input type="number" name="system.strikes.max" value="{{system.strikes.max}}"/><button type="button" data-adjust="strikes.value" data-delta="1">+</button></span></div>
    <div><b>Attack TN</b><input type="number" name="system.attackTarget" value="{{system.attackTarget}}"/></div>
    <div><b>Predator</b><input type="number" name="system.predatorDice" value="{{system.predatorDice}}"/><span>d6</span><button type="button" data-roll="predator">Roll</button></div>
  </section>
  <section class="combat-quickbar">
    <h3>Combat</h3>
    <div class="enemy-combat-controls">
      <label>Attack Style
        <select name="system.attackStyle">
          <option value="melee" {{#if (eq system.attackStyle "melee")}}selected{{/if}}>Melee</option>
          <option value="ranged" {{#if (eq system.attackStyle "ranged")}}selected{{/if}}>Ranged</option>
        </select>
      </label>
      <div class="combat-buttons">
        <button type="button" data-attack="normal">Attack</button>
        <button type="button" data-attack="boon">Attack + Boon</button>
        <button type="button" data-attack="bane">Attack + Bane</button>
      </div>
    </div>
  </section>
  <div class="roll-bar"><button type="button" data-roll="d6">1d6</button><button type="button" data-roll="boon">Boon</button><button type="button" data-roll="bane">Bane</button></div>
  {{#if system.harvesterPoisonBane}}<div class="status-note"><strong>Harvester Poison:</strong> Bane to all actions is active. <label><input type="checkbox" name="system.harvesterPoisonBane" {{checked system.harvesterPoisonBane}}> Active</label></div>{{/if}}
  {{#if system.frogPesterOwnerUuid}}<div class="status-note"><strong>Pestered by Frog:</strong> attacks against {{system.frogPesterOwnerName}} suffer 1 Bane. Target that Frog Tosser before rolling the attack for automatic handling.</div>{{/if}}
  <div class="two-col checks">
    <label><input type="checkbox" name="system.isHollowEyes" {{checked system.isHollowEyes}}> Hollow Eyes</label>
    <label><input type="checkbox" name="system.isHollowTongue" {{checked system.isHollowTongue}}> Hollow Tongue</label>
  </div>
  <label>Description<textarea name="system.description">{{system.description}}</textarea></label>
  <label>Abilities<textarea name="system.abilities">{{system.abilities}}</textarea></label>
  <label>Notes<textarea class="big-notes" name="system.notes">{{system.notes}}</textarea></label>
</form>
